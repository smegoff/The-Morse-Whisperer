[Unit]
Description=The Morse Whisperer CW Decoder Appliance
After=network-online.target sound.target
Wants=network-online.target

[Service]
Type=simple
User=morsewhisperer
Group=morsewhisperer
SupplementaryGroups=audio video
WorkingDirectory=/opt/morse-whisperer-pi
Environment=PYTHONUNBUFFERED=1
EnvironmentFile=-/etc/morse-whisperer/ai.env
ExecStartPre=/usr/bin/timeout 6s /opt/morse-whisperer-pi/venv/bin/python /opt/morse-whisperer-pi/tools/safe_splash_v2.py
ExecStart=/opt/morse-whisperer-pi/venv/bin/python -m morse_whisperer
Restart=on-failure
RestartSec=4
NoNewPrivileges=yes

[Install]
WantedBy=multi-user.target
